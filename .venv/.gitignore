# ======================================================
# Python 项目完整 .gitignore
# 适用：Flask / Django / FastAPI / 通用 Python
# ======================================================

# -------------------- Python 编译文件 --------------------
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info
*.egg-info/
dist/
build/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
*.manifest

# -------------------- Python 缓存 --------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.log
pytestdebug.log

# -------------------- 虚拟环境 --------------------
venv/
env/
ENV/
.venv
.virtualenv
pyenv/
.venv/
venv.bak/
env.bak/
pythonenv*

# -------------------- 敏感信息 --------------------
.env
.env.local
.env.*.local
*.key
*.pem
*.crt
*.p12
*.pfx
secrets.py
config_local.py
local_settings.py
credentials.json
token.json
*.secret
*.secrets
!example.secrets
application-*.yaml
application-*.yml
application-*.properties

# -------------------- 数据库 --------------------
*.db
*.sqlite
*.sqlite3
*.mdb
*.ldb
*.sql
!schema.sql
!seed.sql

# -------------------- 日志文件 --------------------
*.log
*.pid
*.seed
*.pid.lock
logs/
logfiles/
*.log.*

